# =============================================================================
#  Ai Life Concierge - backend environment
#
#  Copy to .env and fill in. Never commit .env.
#
#  Only DATABASE_URL is required to boot. Everything else degrades gracefully:
#  a missing key disables that feature and is reported by /health/integrations
#  rather than crashing the service.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Public origin, no trailing slash. Used to rebuild the exact URL Twilio signed.
# Signature verification FAILS in production if this is wrong.
PUBLIC_BASE_URL=https://api.ailifeconcierge.co.uk

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Admin API (brief 2E) ----------------------------------------------------
# Guards /admin/*. No default: if this is unset the admin API returns 503 rather
# than opening up. Generate one with:  openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Twilio (WhatsApp) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+441483694296

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Airtable (ops dashboard) ------------------------------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Table name wins over table id, matching the prototype's precedence.
AIRTABLE_TABLE_NAME=Users
AIRTABLE_USER_TABLE_ID=
AIRTABLE_TASKS_TABLE_NAME=Tasks
AIRTABLE_TASKS_TABLE_ID=
AIRTABLE_PHONE_FIELD=phone_number
# Linked-record field on Tasks pointing at the user's profile row.
AIRTABLE_TASKS_USER_LINK_FIELD=User

# --- Email (SMTP via nodemailer) ---------------------------------------------
# NOTE: SendGrid is NOT wired up. The brief asks for a SendGrid health check, but
# mail is sent over plain SMTP. /health/integrations reports on SMTP and states
# separately whether a SendGrid key is present. See README, "Deviations".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SENDGRID_API_KEY=

# --- Optional AI / search ----------------------------------------------------
GEMINI_API_KEY=
TAVILY_API_KEY=
COMPOSIO_API_KEY=
PIPEDREAM_CONNECT_ENV=
PIPEDREAM_ENVIRONMENT=

# --- Pipedream (calendar and architecture profile) ---------------------------
PIPEDREAM_CALENDAR_URL=
PIPEDREAM_CALENDAR_TOKEN=
PIPEDREAM_CALENDAR_QUERY_WEBHOOK=
EXECUTE_PIPEDREAM_CALENDAR_TASK_URL=
PIPEDREAM_ARCHITECTURE_PROFILE_TOKEN=
FETCH_ARCHITECTURE_PROFILE_URL=
FETCH_ARCHITECTURE_PROFILE_TOKEN=

# --- Cron --------------------------------------------------------------------
# Hourly nudge to lite users who last spoke 20-23 hours ago.
NUDGE_CRON_SCHEDULE=0 * * * *

# --- Security ----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Both default to ON in production. Only set these to false locally, where
# requests come from a test script with no signature.
VERIFY_TWILIO_SIGNATURE=
VERIFY_STRIPE_SIGNATURE=

# --- Tests -------------------------------------------------------------------
# A THROWAWAY database. The test suite DROPS AND RECREATES the public schema on
# every run. Never point this at production.
TEST_DATABASE_URL=

# --- Credential encryption ------------------------------------------------
# Encrypts calendar OAuth tokens at rest (users.calendar_*_token_enc).
# 32 bytes of hex. Generate with:  openssl rand -hex 32
# Losing this key makes every stored token unrecoverable. Back it up.
TOKEN_ENCRYPTION_KEY=

# --- Front door (Project 3) ------------------------------------------------
# Status routing before Alice. Off until the test accounts are Active.
STATUS_GATE_ENABLED=false
WAITLIST_URL=https://ailifeconcierge.co.uk
ONBOARDING_URL=https://ailifeconcierge.co.uk/onboarding
# Where an Onboarded client pays. ?client_id=<id> is appended.
PAYMENT_URL=
# Hand a client back to Alice after this many quiet minutes in human mode. 0 = off.
HUMAN_MODE_TIMEOUT_MINUTES=120
# Twilio Content SIDs (HX...) once Meta approves each template. Until then the
# same words go out as plain text, which works for replies to inbound messages.
TWILIO_TPL_UNRECOGNIZED_USER=
TWILIO_TPL_STATUS_WAITLIST=
TWILIO_TPL_STATUS_DENIED=
TWILIO_TPL_STATUS_APPROVED=
TWILIO_TPL_PENDING_STRIPE=
TWILIO_TPL_MEMBERSHIP_INACTIVE=
TWILIO_TPL_ACTIVE_WELCOME=

# --- Lifecycle messages (Project 3). All off until each template is approved.
# Twilio Content SIDs (HX...) for the lifecycle templates
TWILIO_TPL_ONBOARDING_REMINDER=
TWILIO_TPL_HANDSHAKE_PING=
TWILIO_TPL_DATENIGHT_PING=
# Stripe checkout sets status Active and sends the welcome
STRIPE_SETS_ACTIVE=false
ONBOARDING_REMINDER_ENABLED=false
ONBOARDING_REMINDER_HOURS=24
HANDSHAKE_PING_ENABLED=false
HANDSHAKE_PING_HOURS=48
PROPOSAL_NUDGE_ENABLED=false
PROPOSAL_NUDGE_HOURS=4
# On: a due date night sends the morning ping (Review / Skip). Off: desk task.
DATE_NIGHT_PING_ENABLED=false
DATE_NIGHT_PING_HOUR=9
LIFECYCLE_CRON_SCHEDULE=*/15 * * * *

# Numbers (+447...) that go through the front door while STATUS_GATE_ENABLED is off
STATUS_GATE_TEST_NUMBERS=

# OAuth apps used by the onboarding flow. Only needed to REFRESH clients' calendar tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
